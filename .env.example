# Runtime storage (local and ignored by Git)
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/liveuiagent.db
GENERATED_APPS_DIR=./generated-apps

# Configure here or through the GUI settings dialog. Never commit real keys.
OPENAI_API_KEY=
OPENAI_API_BASE=
LIVEUIAGENT_ORCHESTRATOR_MODEL=

# Optional DSH reasoning transport for Native component applications.
# LIVEUI_NATIVE_DSH_COMMAND=dsh
# LIVEUI_NATIVE_DSH_ARGS=["--profile","headless","--json"]
# LIVEUI_NATIVE_DSH_TIMEOUT_MS=120000
# LIVEUI_NATIVE_DSH_MAX_CONCURRENT=4

# Optional authenticated, inference-only Codex relay. No Codex login is sent to the browser.
# LIVEUIAGENT_CODEX_BASE_URL=http://127.0.0.1:19503/v1
# LIVEUIAGENT_CODEX_TOKEN=
# Restrict a personal Codex login to named authenticated accounts.
# LIVEUIAGENT_CODEX_ALLOWED_USERS=
# LIVEUIAGENT_CODEX_MODEL=gpt-6-astra
# LIVEUIAGENT_CODEX_TIMEOUT_MS=180000
# LIVEUIAGENT_CODEX_MAX_CONCURRENT=2

# Optional HTML DSH service API root, including its mount prefix.
# Used by existing HTML apps or explicit delivery: "html" requests.
# This adapter expects the trusted-gateway service, not the native plugin cookie flow.
LIVEUIAGENT_DSH_API_BASE=
LIVEUI_DEFAULT_HARNESS=native

# Optional namespace for an existing DSH service.
# LIVEUI_DSH_USER_PREFIX=liveuiagent:
# LIVEUI_DSH_EMPTY_ACCOUNT_ROOT=/absolute/path/to/dsh/data

# Optional: frontend URL for browser-based evaluation.
# LIVEUIAGENT_FRONTEND_URL=http://127.0.0.1:8787
# CHROME_PATH=/path/to/chrome
# EXPO_PUBLIC_AGENT_GATEWAY_URL=http://127.0.0.1:8787

# Official Qwen Code / Kimi Code / ZCode reasoning runtimes.
# Each is offered only when the matching API model family is configured.
# LIVEUI_QWEN_COMMAND=/usr/bin/node
# LIVEUI_QWEN_ARGS=["/opt/liveui-harnesses/node_modules/@qwen-code/qwen-code/cli-entry.js"]
# LIVEUI_KIMI_COMMAND=/usr/bin/node
# LIVEUI_KIMI_ARGS=["/opt/liveui-harnesses/node_modules/@moonshot-ai/kimi-code/dist/main.mjs"]
# LIVEUI_ZCODE_COMMAND=/usr/bin/node
# LIVEUI_ZCODE_ARGS=["/opt/liveui-harnesses/zcode/zcode.cjs"]
# LIVEUI_DOMESTIC_MAX_CONCURRENT=2
# LIVEUI_DOMESTIC_TIMEOUT_MS=180000
